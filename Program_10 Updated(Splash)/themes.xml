<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Theme"
        parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="MyTheme"
        parent="Theme.Material3.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">#590016</item>
        <item name="android:windowBackground">#E3BC9A</item>

    </style>

    <!-- SPLASH SCREEN -->
    <style name="Theme.App.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#000000</item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/legacies
        </item>

        <item name="postSplashScreenTheme">
            @style/MyTheme
        </item>

    </style>

    <style name="Theme.Theme"
        parent="Base.Theme.Theme" />

</resources>
